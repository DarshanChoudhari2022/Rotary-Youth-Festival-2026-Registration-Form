{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/booking.js": { "includeFiles": "{fonts/**,assets/ticket-logos.png}" },
    "api/admin.js": { "includeFiles": "{fonts/**,assets/ticket-logos.png}" }
  },
  "rewrites": [{ "source": "/admin", "destination": "/admin.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/:page(admin|admin\\.html)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
